DISCORD_TOKEN=
GEMINI_API_KEY=
# Optional backup Gemini keys. They are useful for invalid/auth failures and can also help quota only when
# the keys belong to genuinely independent projects. Google quotas are project/model based, not per key.
# Comma-separated, for example: GEMINI_BACKUP_API_KEYS=key2,key3
GEMINI_BACKUP_API_KEYS=
# Numbered keys GEMINI_API_KEY_2 through GEMINI_API_KEY_10 are also supported.
# GEMINI_API_KEY_2=
# Legacy/default Gemini model. Workload routes below are preferred; this value is appended as a last-resort
# fallback for non-search workloads so existing installations remain backward compatible.
GEMINI_MODEL=gemini-3.6-flash
# Workload-specific model chains, tried left-to-right. Leave unset to use the built-in defaults shown here.
# Google publishes actual active RPM/TPM/RPD per project in AI Studio; do not hard-code public quota guesses.
# GEMINI_MODELS_CHAT=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemma-4-31b-it
# GEMINI_MODELS_REASONING=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-pro,gemma-4-31b-it
# GEMINI_MODELS_TOOLS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash
# GEMINI_MODELS_VISION=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash
# GEMINI_MODELS_SOCIAL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-26b-a4b-it
# GEMINI_MODELS_MEMORY=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemma-4-26b-a4b-it
# Meeting reports keep their existing 240-second task timeout and use a quality-first route.
# GEMINI_MODELS_MEETING=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-pro,gemma-4-31b-it
# Search has its own explicit route so retired model IDs can be replaced without changing general chat.
# Override this only with models that support Google Search for your Gemini project.
# GEMINI_MODELS_SEARCH=gemini-3.6-flash,gemini-3.5-flash-lite
# Leave empty to register slash commands globally. Use a test server ID during development.
DISCORD_GUILD_ID=
DJ_ROLE_NAME=DJ
# Recommended: Discord role ID. When set, it takes precedence over DJ_ROLE_NAME.
DJ_ROLE_ID=
MAX_UPLOAD_MB=25
# Leave either name empty to disable that channel-specific feature.
PERSONA_CHANNEL_NAME=墨雪的貓窩
INTRODUCTION_CHANNEL_NAME=墨雪的自我介紹
# Prevent passive chat from becoming spammy or expensive.
PASSIVE_DECISION_COOLDOWN_SECONDS=90
PASSIVE_RESPONSE_COOLDOWN_SECONDS=120
TOPIC_IDLE_MINUTES=15
TOPIC_MIN_INTERVAL_MINUTES=180
# IANA timezone used for current-time answers and daily persona quiet hours.
PERSONA_TIMEZONE=Asia/Taipei
VOICE_EMPTY_DISCONNECT_MINUTES=30
VOICE_TEST_CHANNEL_NAME=測試
# Keep false until a voice receiving extension and recognition engine are installed.
VOICE_RECOGNITION_ENABLED=false
VOICE_RECOGNITION_MODEL=small
VOICE_RECOGNITION_LANGUAGE=zh
VOICE_RECOGNITION_BEAM_SIZE=5
VOICE_RECOGNITION_SILENCE_SECONDS=1.8
VOICE_RECOGNITION_MAX_SEGMENT_SECONDS=20
VOICE_RECOGNITION_INITIAL_PROMPT=以下是繁體中文 Discord 語音聊天的逐字稿。

# Text-to-speech legacy/provider fallback. Distributed workers, when configured below, are tried first.
# auto = Gemini free-tier TTS -> optional local Kokoro -> Windows SAPI.
# Gemini TTS uses the same primary + backup key pool as chat.
TTS_PROVIDER=auto
# Legacy single-model setting kept for compatibility. The multi-model chain below is preferred.
TTS_GEMINI_MODEL=gemini-3.1-flash-tts-preview
# TTS_GEMINI_MODELS=gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts
TTS_GEMINI_VOICE=Leda
TTS_GEMINI_TIMEOUT_SECONDS=45
# Natural-language voice direction. Keep this on one line in .env.
TTS_GEMINI_STYLE=Speak in natural Taiwan Mandarin with a youthful, soft female voice. Sound warm, relaxed, slightly playful, and conversational. Use natural pauses and subtle emotional variation. Avoid announcer-like delivery.
# Kokoro is optional and runs locally after: python -m pip install -e ".[tts-local]"
TTS_KOKORO_ENABLED=true
TTS_KOKORO_VOICE=zf_xiaoni
TTS_KOKORO_SPEED=1.0

# Distributed Moxue TTS worker pool. Entries are tried left-to-right in auto mode.
# Example for the planned 3090 desktop -> 4070 laptop -> local 1660 Ti fallback order:
# TTS_REMOTE_WORKERS=desktop=http://<desktop-lan-host>:8891;laptop=http://<laptop-lan-host>:8891;local=http://127.0.0.1:8891
TTS_REMOTE_WORKERS=
# Use the same long random token on the Bot and every LAN worker. Do not commit the real value.
TTS_WORKER_TOKEN=
# auto, or one configured worker name such as desktop / laptop / local.
TTS_WORKER_MODE=auto
TTS_WORKER_HEALTH_TIMEOUT_SECONDS=2
TTS_WORKER_REQUEST_TIMEOUT_SECONDS=45
TTS_WORKER_FAILURE_COOLDOWN_SECONDS=15

# Settings below are for a machine running `moxue-tts-worker`, not normally for the Discord Bot process.
# The worker is a thin authenticated proxy around a local GPT-SoVITS api_v2 server.
# Start GPT-SoVITS api_v2 locally (normally port 9880), then start `moxue-tts-worker`.
# For a remote LAN worker use 0.0.0.0 plus MOXUE_TTS_WORKER_TOKEN and allow only your trusted LAN/VPN in the firewall.
# Never expose the plain HTTP worker directly to the public Internet.
# MOXUE_TTS_WORKER_NAME=desktop
# MOXUE_TTS_WORKER_HOST=0.0.0.0
# MOXUE_TTS_WORKER_PORT=8891
# MOXUE_TTS_WORKER_TOKEN=
# MOXUE_TTS_UPSTREAM_URL=http://127.0.0.1:9880
# Reference audio path is local to each worker machine. Keep the same Moxue voice assets on all workers.
# MOXUE_TTS_REF_AUDIO_PATH=
# Prompt language describes the reference audio itself and stays fixed even when target speech changes language.
# MOXUE_TTS_PROMPT_TEXT=這是墨雪的參考語音。
# MOXUE_TTS_PROMPT_LANG=zh
# Bot-side remote routing detects target speech per utterance: zh / yue / en / ja / ko.
# MOXUE_TTS_TEXT_LANG is only the worker's backward-compatible default when an older/manual client omits text_lang.
# MOXUE_TTS_TEXT_LANG=zh
# MOXUE_TTS_SPEED_FACTOR=1.0
# MOXUE_TTS_UPSTREAM_TIMEOUT_SECONDS=45
# MOXUE_TTS_MAX_CONCURRENCY=1
# Auto-yield the worker when gaming/CUDA work makes the GPU busy.
# MOXUE_TTS_GPU_PROBE_ENABLED=true
# MOXUE_TTS_GPU_BUSY_THRESHOLD=80
# MOXUE_TTS_GPU_MIN_FREE_MB=1800

# Optional YouTube access settings. Use only one cookies source. Both values are sensitive.
# YOUTUBE_COOKIES_FROM_BROWSER=chrome
# YOUTUBE_COOKIES_FILE=data/youtube-cookies.txt
# YOUTUBE_PO_TOKEN=

# Tavily is reserved for explicit deep research / multi-source verification / webpage reading.
# Ordinary current-fact questions keep using Gemini's native Google Search route.
TAVILY_API_KEY=
WEB_RESEARCH_MAX_RESULTS=5
WEB_RESEARCH_TIMEOUT_SECONDS=20

# Cloudflare Workers AI image generation. The action is exposed only for explicit image-generation wording.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
IMAGE_GEN_MODEL=@cf/black-forest-labs/flux-1-schnell
IMAGE_GEN_STEPS=4
IMAGE_GEN_TIMEOUT_SECONDS=50
IMAGE_GEN_USER_COOLDOWN_SECONDS=60
IMAGE_GEN_MAX_CONCURRENCY=1

# Dynamic external tool gateway. Keep HOST on loopback unless you also set TOOL_GATEWAY_TOKEN.
TOOL_GATEWAY_ENABLED=true
TOOL_GATEWAY_EMBEDDED=true
TOOL_GATEWAY_HOST=127.0.0.1
TOOL_GATEWAY_PORT=8765
TOOL_GATEWAY_REFRESH_SECONDS=30
TOOL_GATEWAY_TIMEOUT_SECONDS=60
# TOOL_GATEWAY_TOKEN=

# Capture Hub accepts outbound MoxueCapture clients. 127.0.0.1 = local only.
# For a laptop on the same trusted LAN, set CAPTURE_HUB_HOST=0.0.0.0 and allow TCP 8878 in Windows Firewall.
# Do NOT expose the current ws:// transport directly to the public Internet; use a trusted LAN/VPN until TLS is added.
CAPTURE_HUB_ENABLED=true
CAPTURE_HUB_HOST=127.0.0.1
CAPTURE_HUB_PORT=8878

# Set this only on a remote Capture Agent machine, not on the Discord Bot server.
# Example: MOXUE_CAPTURE_HUB_URL=ws://<capture-hub-host>:8878/capture/ws
# MOXUE_CAPTURE_HUB_URL=


# Moxue Hub outbound heartbeat. Leave URL empty to disable.
# This is outbound-only: the Bot does not expose a public inbound health port.
MOXUE_HEARTBEAT_URL=
MOXUE_HEARTBEAT_TOKEN=
MOXUE_HEARTBEAT_INTERVAL_SECONDS=60
MOXUE_HEARTBEAT_TIMEOUT_SECONDS=8
